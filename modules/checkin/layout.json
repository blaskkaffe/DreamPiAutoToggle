{
 "dashboard": [
  {
   "box": "checkin",
   "items": [
    {
     "type": "roster",
     "source": "@checkin",
     "toggle": "/checkin/toggle",
     "status": "/checkin/status"
    }
   ]
  }
 ],
 "settings": [
  {
   "box": "check-in",
   "title": "Check-in board",
   "items": [
    {
     "type": "text",
     "muted": true,
     "text": "The board that every screen shows: a box per department or building, a row per person with an INNE / UTE button and a status menu. These settings change how the board looks and works on all screens; the people come from Contacts and the statuses from Statuses."
    },
    {
     "type": "form",
     "get": "/checkin/config",
     "post": "/checkin/config",
     "fields": [
      {
       "title": "Title",
       "sub_text": "show_title",
       "controls": [
        {
         "type": "toggle",
         "key": "show_title",
         "label": "Show the title"
        }
       ],
       "inline": true
      },
      {
       "title": "Page title",
       "inline": true,
       "controls": [
        {
         "type": "text",
         "key": "title",
         "label": "Page title (empty = Check-in)"
        }
       ]
      },
      {
       "title": "Group people by",
       "sub_text": "group_by",
       "controls": [
        {
         "type": "select",
         "key": "group_by",
         "options": "groups",
         "label": "Group by"
        }
       ],
       "inline": true
      },
      {
       "title": "Colour people by",
       "sub_text": "colour_by",
       "controls": [
        {
         "type": "select",
         "key": "colour_by",
         "options": "groups",
         "label": "Colour by"
        }
       ],
       "inline": true
      },
      {
       "title": "Scrolling text",
       "inline": true,
       "controls": [
        {
         "type": "select",
         "key": "scroll",
         "options": "scrolls",
         "label": "Scrolling name and status"
        }
       ]
      },
      {
       "title": "Box frame",
       "inline": true,
       "controls": [
        {
         "type": "select",
         "key": "frame",
         "options": "frames",
         "label": "Frame round the boxes"
        }
       ]
      },
      {
       "title": "Box colour",
       "inline": true,
       "controls": [
        {
         "type": "select",
         "key": "box",
         "options": "boxes",
         "label": "Colour of the boxes"
        }
       ]
      },
      {
       "title": "Display roles",
       "inline": true,
       "controls": [
        {
         "type": "toggle",
         "key": "show_roles",
         "label": "Display roles"
        }
       ],
       "edit": {
        "type": "checklist",
        "key": "roles_shown",
        "options": "roles",
        "title": "Roles to display",
        "empty": "No roles on file yet"
       }
      },
      {
       "title": "Display buildings",
       "inline": true,
       "controls": [
        {
         "type": "toggle",
         "key": "show_buildings",
         "label": "Display buildings"
        }
       ],
       "edit": {
        "type": "checklist",
        "key": "buildings_shown",
        "options": "buildings",
        "title": "Buildings to display",
        "empty": "No buildings on file yet"
       }
      },
      {
       "title": "Touch keyboard",
       "inline": true,
       "controls": [
        {
         "type": "toggle",
         "key": "keyboard",
         "label": "On-screen keyboard for times, dates and notes"
        }
       ]
      }
     ]
    },
    {
     "type": "roster",
     "mode": "colours",
     "get": "/checkin/config",
     "post": "/checkin/colour"
    },
    {
     "type": "row",
     "title": "Start of the day",
     "sub": "Everybody out, statuses cleared",
     "control": {
      "type": "button",
      "label": "All out",
      "arm": "Tap again",
      "post": "/checkin/all",
      "body": {
       "in": false
      }
     }
    },
    {
     "type": "row",
     "title": "Everybody in",
     "sub": "Everybody in, statuses cleared",
     "control": {
      "type": "button",
      "label": "All in",
      "arm": "Tap again",
      "post": "/checkin/all",
      "body": {
       "in": true
      }
     }
    }
   ]
  },
  {
   "box": "statuses",
   "title": "Statuses",
   "items": [
    {
     "type": "text",
     "muted": true,
     "text": "What can be picked in the status menu on the board. Tap a status to change it. A sticky status stays when INNE / UTE is pressed; the others are cleared."
    },
    {
     "type": "custom",
     "name": "checkin-statuses",
     "html": "<div class=\"cstatuses\"></div>"
    }
   ]
  },
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "row",
     "title": "Check-in board colour",
     "sub": "Module",
     "control": {
      "type": "swatches",
      "tint": true,
      "key": "checkin",
      "title": "Colour of the check-in board"
     },
     "in": "colours",
     "order": 30
    }
   ]
  }
 ]
}
