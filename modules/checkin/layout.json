{
 "dashboard": [
  {
   "box": "checkin",
   "items": [
    {
     "type": "roster",
     "source": "@checkin",
     "toggle": "/checkin/toggle",
     "status": "/checkin/status"
    }
   ]
  }
 ],
 "settings": [
  {
   "box": "check-in",
   "title": "Check-in board",
   "items": [
    {
     "type": "text",
     "text": "@checkin.text"
    },
    {
     "type": "form",
     "get": "/checkin/config",
     "post": "/checkin/config",
     "fields": [
      {
       "title": "Title",
       "sub_text": "show_title",
       "controls": [
        {
         "type": "toggle",
         "key": "show_title",
         "label": "Show the title"
        }
       ],
       "inline": true
      },
      {
       "title": "Group people by",
       "sub_text": "group_by",
       "controls": [
        {
         "type": "select",
         "key": "group_by",
         "options": "groups",
         "label": "Group by"
        }
       ],
       "inline": true
      },
      {
       "title": "Colour people by",
       "sub_text": "colour_by",
       "controls": [
        {
         "type": "select",
         "key": "colour_by",
         "options": "groups",
         "label": "Colour by"
        }
       ],
       "inline": true
      }
     ]
    },
    {
     "type": "roster",
     "mode": "colours",
     "get": "/checkin/config",
     "post": "/checkin/colour"
    },
    {
     "type": "row",
     "title": "Start of the day",
     "sub": "Everybody out, statuses cleared",
     "control": {
      "type": "button",
      "label": "All out",
      "arm": "Tap again",
      "post": "/checkin/all",
      "body": {
       "in": false
      }
     }
    },
    {
     "type": "row",
     "title": "Everybody in",
     "sub": "Everybody in, statuses cleared",
     "control": {
      "type": "button",
      "label": "All in",
      "arm": "Tap again",
      "post": "/checkin/all",
      "body": {
       "in": true
      }
     }
    }
   ]
  },
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "row",
     "title": "Check-in board colour",
     "sub": "Module",
     "control": {
      "type": "swatches",
      "tint": true,
      "key": "checkin",
      "title": "Colour of the check-in board"
     }
    }
   ]
  }
 ]
}
