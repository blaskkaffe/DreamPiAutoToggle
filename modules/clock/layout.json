{
 "dashboard": [
  {"box": "clock", "items": [
   {"type": "infobox", "label": "@clock.beat", "title": "@clock.time", "rows": [
    {"label": "World", "main": true, "value": {"type": "carousel", "items": "@clock.items"}},
    {"label": "", "cls": "mapw", "show": "@clock.world", "value": {"type": "custom", "name": "clock-map"}}]}
  ]}
 ],
 "settings": [
  {"box": "clock", "title": "Clock", "items": [
   {"type": "form", "get": "/clock", "post": "/clock", "fields": [
    {"title": "Time format", "sub_text": "clock",
     "controls": [{"type": "select", "key": "format", "options": "formats", "label": "Format"}]}]},
   {"type": "row", "title": ".beat time", "sub": "Swatch Internet Time on the top line: the same everywhere",
    "control": {"type": "toggle", "bind": "@clock.beat_on", "post": "/clock/beat", "label": ".beat time"}},
   {"type": "row", "title": "World time", "sub": "A scrolling list of cities on the bottom line; tap the clock to see the time zone map",
    "control": {"type": "toggle", "bind": "@clock.world", "post": "/clock/world", "label": "World time"}}]},
  {"box": "appearance", "title": "Appearance", "items": [
   {"type": "row", "title": "Clock colour", "sub": "Module", "control": {"type": "swatches", "key": "clock", "title": "Colour of the clock"}}]}
 ]
}
