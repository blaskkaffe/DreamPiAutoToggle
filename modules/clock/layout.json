{
 "dashboard": [
  {
   "box": "clock",
   "items": [
    {
     "type": "infobox",
     "label": "@clock.beat",
     "title": "@clock.time",
     "open_if": "@clock.world",
     "rows": [
      {
       "label": "World",
       "main": true,
       "only": "closed",
       "value": {
        "type": "carousel",
        "items": "@clock.items"
       }
      },
      {
       "label": "",
       "full": true,
       "show": "@clock.world",
       "value": {
        "type": "list",
        "style": "grid",
        "items": "@clock.cities",
        "row": {
         "title": "title",
         "tag": "tag"
        }
       }
      },
      {
       "label": "",
       "full": true,
       "show": "@clock.world",
       "value": {
        "type": "worldmap",
        "map": "@clock.map",
        "format": "@clock.format"
       }
      }
     ],
     "title_rows": "@clock.size"
    }
   ]
  }
 ],
 "settings": [
  {
   "box": "clock",
   "title": "Clock",
   "items": [
    {
     "type": "form",
     "get": "/clock",
     "post": "/clock",
     "fields": [
      {
       "title": "Time format",
       "sub_text": "clock",
       "controls": [
        {
         "type": "choice",
         "key": "format",
         "options": "formats",
         "label": "Format"
        }
       ]
      }
     ]
    },
    {
     "type": "row",
     "title": ".beat time",
     "sub": "Swatch Internet Time on the top line: the same everywhere",
     "control": {
      "type": "toggle",
      "bind": "@clock.beat_on",
      "post": "/clock/beat",
      "label": ".beat time"
     }
    },
    {
     "type": "row",
     "title": "World time",
     "sub": "The cities below on the bottom line; tap the clock to see them with the time zone map",
     "control": {
      "type": "toggle",
      "bind": "@clock.world_on",
      "post": "/clock/world",
      "label": "World time"
     }
    },
    {
     "type": "row",
     "title": "Large clock",
     "sub": "The time takes the rows the other two lines leave free",
     "control": {
      "type": "toggle",
      "bind": "@clock.large_on",
      "post": "/clock/large",
      "label": "Large clock"
     }
    },
    {
     "type": "picker",
     "source": "/clock/cities",
     "edit": true
    }
   ]
  },
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "row",
     "title": "Clock colour",
     "sub": "Module",
     "control": {
      "type": "swatches",
      "tint": true,
      "key": "clock",
      "title": "Colour of the clock"
     }
    }
   ]
  }
 ]
}
