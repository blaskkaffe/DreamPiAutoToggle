{
 "settings": [
  {
   "box": "players",
   "title": "Online players",
   "items": [
    {
     "type": "picker",
     "source": "/players/favorites",
     "reload": "players"
    }
   ]
  },
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "row",
     "title": "Online players colour",
     "sub": "Module",
     "control": {
      "type": "swatches",
      "key": "players",
      "tint": true,
      "title": "Colour of the online players box"
     }
    }
   ]
  }
 ],
 "dashboard": [
  {
   "box": "players",
   "items": [
    {
     "type": "infobox",
     "label": "Online players:",
     "parts": "@players.parts",
     "rows": [
      {
       "label": "Games",
       "main": true,
       "busy": "@players.busy",
       "value": {
        "type": "carousel",
        "items": "@players.games"
       },
       "only": "closed"
      },
      {
       "label": "Games",
       "value": {
        "type": "list",
        "style": "compact",
        "items": "@players.games_list",
        "empty": "Nobody is in a game",
        "row": {
         "title": "title",
         "sub": "sub",
         "icon": {
          "kind": "star",
          "post": "/players/star",
          "on": "starred",
          "data": "players",
          "body": {
           "kind": "game"
          },
          "fields": {
           "name": "title"
          }
         }
        }
       }
      },
      {
       "label": "Players",
       "busy": "@players.busy",
       "value": {
        "type": "list",
        "style": "compact",
        "items": "@players.list",
        "empty": "Nobody is online",
        "row": {
         "title": "title",
         "sub": "sub",
         "tag": "tag",
         "tag_colour": "colour",
         "icon": {
          "kind": "star",
          "post": "/players/star",
          "on": "starred",
          "data": "players",
          "body": {
           "kind": "player"
          },
          "fields": {
           "name": "title"
          }
         }
        }
       }
      },
      {
       "label": "Status",
       "value": {
        "type": "text",
        "text": "@players.status"
       }
      },
      {
       "label": "Links",
       "value": {
        "type": "links",
        "items": "@players.links"
       }
      }
     ]
    }
   ]
  }
 ],
 "data": {
  "players": {
   "url": "/players",
   "every": 60,
   "retry": 2,
   "retry_if": "retry"
  }
 }
}
