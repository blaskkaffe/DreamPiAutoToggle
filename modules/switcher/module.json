{
 "name": "Network switcher",
 "description": "Switch between DCNow! and DCNET.",
 "enabled": true,
 "visible": false,
 "order": 10,
 "ui": 2,
 "colours": {
  "dcnow": "orange",
  "dcnet": "blue"
 },
 "colours_unique": true,
 "web": "netswitch_switcher",
 "primary": "dcnow",
 "io": "netswitch_switcher_io",
 "inputs": [
  {
   "id": "select_network",
   "label": "Select a network",
   "params": [
    {
     "key": "network",
     "label": "Network",
     "type": "select",
     "options": [
      [
       "dcnow",
       "DCNow!"
      ],
      [
       "dcnet",
       "DCNET"
      ]
     ]
    }
   ],
   "summary": "Select {network}"
  },
  {
   "id": "toggle_network",
   "label": "Switch to the other network",
   "summary": "Switch network"
  }
 ],
 "outputs": [
  {
   "id": "network_selected",
   "label": "The selected network changed"
  }
 ]
}
