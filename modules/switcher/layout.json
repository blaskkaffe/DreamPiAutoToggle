{
 "dashboard": [
  {
   "box": "network",
   "items": [
    {
     "type": "infobox",
     "label": "Selected network:",
     "title": "@selected.title",
     "rows": [
      {
       "label": "DreamPi",
       "main": true,
       "value": {
        "type": "status",
        "dot": "@dreampi.look",
        "text": "@dreampi.text"
       }
      },
      {
       "label": "Modem",
       "value": {
        "type": "status",
        "text": "@modem.text",
        "sub": "@modem.since_text"
       }
      },
      {
       "label": "Internet",
       "value": {
        "type": "status",
        "dot": "@internet.state",
        "text": "@internet.text"
       }
      },
      {
       "label": "Pi",
       "value": {
        "type": "status",
        "dot": "@pi.state",
        "lines": "@pi.lines"
       }
      }
     ],
     "actions": [
      {
       "type": "button",
       "style": "danger",
       "label": "Hang up",
       "arm": "Tap again to hang up",
       "busy": "@hangup.busy",
       "busy_label": "@hangup.text",
       "post": "/hangup",
       "aria": "Ends the current call and gets the modem ready again"
      }
     ],
     "actions_show": "@hangup.visible"
    },
    {
     "type": "button",
     "style": "pill",
     "label": "DCNow! / DreamPi",
     "colour": "dcnow",
     "post": "/dcnow"
    },
    {
     "type": "button",
     "style": "pill",
     "label": "DCNET / FLYCAST",
     "colour": "dcnet",
     "post": "/dcnet"
    }
   ]
  }
 ],
 "settings": [
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "row",
     "title": "DCNow! colour",
     "control": {
      "type": "swatches",
      "key": "dcnow",
      "title": "Colour for DCNow!"
     }
    },
    {
     "type": "row",
     "title": "DCNET colour",
     "control": {
      "type": "swatches",
      "key": "dcnet",
      "title": "Colour for DCNET"
     }
    },
    {
     "type": "form",
     "get": "/highlight",
     "post": "/highlight",
     "fields": [
      {
       "title": "Highlight",
       "sub_text": "highlight",
       "controls": [
        {
         "type": "select",
         "key": "style",
         "options": "styles",
         "label": "Look"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "box": "gpio",
   "title": "GPIO",
   "items": [
    {
     "type": "form",
     "get": "/buttonconfig",
     "post": "/buttonconfig",
     "fields": [
      {
       "title": "Button 1",
       "sub_text": "button1",
       "controls": [
        {
         "type": "select",
         "key": "button1_function",
         "options": "functions",
         "label": "Function"
        },
        {
         "type": "select",
         "key": "button1_gpio",
         "options": "gpios",
         "label": "Pin"
        }
       ]
      },
      {
       "title": "Button 2",
       "sub_text": "button2",
       "controls": [
        {
         "type": "select",
         "key": "button2_function",
         "options": "functions",
         "label": "Function"
        },
        {
         "type": "select",
         "key": "button2_gpio",
         "options": "gpios",
         "label": "Pin"
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
