{
 "dashboard": [
  {
   "box": "network",
   "items": [
    {
     "type": "infobox",
     "label": "Selected network:",
     "parts": "@selected.parts",
     "rows": [
      {
       "label": "DreamPi",
       "main": true,
       "value": {
        "type": "status",
        "dot": "@dreampi.look",
        "text": "@dreampi.text"
       }
      },
      {
       "label": "Modem",
       "value": {
        "type": "status",
        "dot": "@modem.state",
        "text": "@modem.text",
        "sub": "@modem.since_text"
       }
      },
      {
       "label": "Internet",
       "value": {
        "type": "status",
        "dot": "@internet.state",
        "text": "@internet.text",
        "sub": "@internet.sub"
       }
      },
      {
       "label": "Pi",
       "value": {
        "type": "status",
        "dot": "@pi.state",
        "lines": "@pi.lines"
       }
      }
     ],
     "actions": [
      {
       "type": "button",
       "style": "danger",
       "label": "Hang up",
       "arm": "Tap again to hang up",
       "busy": "@hangup.busy",
       "busy_label": "@hangup.text",
       "post": "/hangup",
       "aria": "Ends the current call and gets the modem ready again"
      }
     ],
     "actions_show": "@hangup.visible"
    },
    {
     "type": "button",
     "style": "pill",
     "label": "DCNow! / DreamPi",
     "colour": "dcnow",
     "post": "/dcnow"
    },
    {
     "type": "button",
     "style": "pill",
     "label": "DCNET / FLYCAST",
     "colour": "dcnet",
     "post": "/dcnet"
    }
   ]
  }
 ],
 "settings": [
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "row",
     "title": "Network Selector colour",
     "sub": "Module",
     "control": {
      "type": "swatches", "tint": true,
      "key": "selector",
      "title": "Colour of the DreamPi Network Selector"
     }
    },
    {"type": "palette"},
    {
     "type": "form",
     "get": "/screen",
     "post": "/screen",
     "fields": [
      {
       "title": "Theme",
       "sub_text": "theme",
       "controls": [{"type": "choice", "key": "theme", "options": "themes", "label": "Theme"}]
      },
      {
       "title": "Max columns: dashboard",
       "sub_text": "dash_cols",
       "controls": [{"type": "choice", "key": "dash_cols", "options": "cols", "label": "Columns"}]
      },
      {
       "title": "Max columns: settings",
       "sub_text": "set_cols",
       "controls": [{"type": "choice", "key": "set_cols", "options": "cols", "label": "Columns"}]
      }
     ]
    },
    {
     "type": "row",
     "title": "Stretch boxes",
     "sub": "On a wide screen the columns fill the width, so the boxes are wider",
     "control": {"type": "toggle", "bind": "@screen.stretch", "post": "/screen/stretch", "label": "Stretch boxes"}
    },
    {
     "type": "row",
     "title": "Scale content",
     "sub": "The content of a stretched box grows with it, so the box is taller too (off: the content keeps its size)",
     "show": "@screen.stretch",
     "control": {"type": "toggle", "bind": "@screen.scale", "post": "/screen/scale", "label": "Scale content"}
    },
    {
     "type": "row",
     "title": "Fit to screen",
     "sub": "The main screen is made as big as it can be without scrolling, so there is no empty space under it (the columns fill the width; neither Stretch nor scaling is needed)",
     "control": {"type": "toggle", "bind": "@screen.fit", "post": "/screen/fit", "label": "Fit to screen"}
    },
    {
     "type": "row",
     "title": "Rearrange the main screen",
     "sub": "A handle on each tile lets you drag it to another place; the modules take that order (the same as dragging them in Modules)",
     "control": {"type": "toggle", "bind": "@screen.drag", "post": "/screen/drag", "label": "Rearrange the main screen"}
    },
    {
     "type": "row",
     "title": "Ask for the PIN to open Settings",
     "sub": "The dashboard keeps working without it; opening Settings and changing anything in it needs the PIN. Set a PIN below first.",
     "control": {"type": "toggle", "bind": "@settings_pin.on", "post": "/settings-pin", "label": "Ask for the PIN to open Settings"}
    },
    {
     "type": "row",
     "title": "PIN",
     "sub": "4 to 64 characters. It is also asked for before updating, restarting the Pi and joining Wi-Fi.",
     "control": {"type": "pinset"}
    }
   ]
  },
  {
   "box": "colours",
   "title": "Global colours",
   "items": [
    {
     "type": "row",
     "title": "DCNow! colour",
     "sub": "Network",
     "control": {
      "type": "swatches",
      "key": "dcnow",
      "exclude": ["network"],
      "title": "Colour for DCNow!"
     }
    },
    {
     "type": "row",
     "title": "DCNET colour",
     "sub": "Network",
     "control": {
      "type": "swatches",
      "key": "dcnet",
      "exclude": ["network"],
      "title": "Colour for DCNET"
     }
    },
    {
     "type": "row",
     "title": "Global main colour",
     "sub": "Pick Global main for a box or a row of the LEDs to give them this colour",
     "control": {"type": "colourpick", "id": "global", "label": "Global main colour"}
    },
    {
     "type": "form",
     "get": "/highlight",
     "post": "/highlight",
     "fields": [
      {
       "title": "Notification highlight",
       "sub_text": "highlight",
       "controls": [
        {
         "type": "select",
         "key": "style",
         "options": "styles",
         "label": "Look"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "box": "gpio",
   "title": "GPIO",
   "items": [
    {
     "type": "form",
     "get": "/buttonconfig",
     "post": "/buttonconfig",
     "fields": [
      {
       "title": "Button 1",
       "sub_text": "button1",
       "controls": [
        {
         "type": "select",
         "key": "button1_function",
         "options": "functions",
         "label": "Function"
        },
        {
         "type": "select",
         "key": "button1_gpio",
         "options": "gpios",
         "label": "Pin"
        }
       ]
      },
      {
       "title": "Button 2",
       "sub_text": "button2",
       "controls": [
        {
         "type": "select",
         "key": "button2_function",
         "options": "functions",
         "label": "Function"
        },
        {
         "type": "select",
         "key": "button2_gpio",
         "options": "gpios",
         "label": "Pin"
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
