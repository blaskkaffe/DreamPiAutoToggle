{
 "settings": [
  {
   "box": "gpio",
   "title": "GPIO",
   "items": [
    {
     "type": "form",
     "get": "/ledhardware",
     "post": "/ledhardware",
     "show": "@led.installed",
     "fields": [
      {
       "title": "LED",
       "sub_text": "led",
       "controls": [
        {
         "type": "number",
         "key": "led_count",
         "min": 1,
         "max": 300,
         "label": "LEDs connected"
        },
        {
         "type": "select",
         "key": "led_order",
         "options": "orders",
         "label": "Wire order"
        },
        {
         "type": "select",
         "key": "led_gpio",
         "options": "gpios",
         "label": "Output pin"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "box": "status led",
   "title": "@led.title",
   "items": [
    {
     "type": "custom",
     "name": "led-tools",
     "show": "@led.installed",
     "html_file": "messages.html"
    },
    {
     "type": "triggers",
     "source": "/ledrows",
     "show": "@led.installed"
    }
   ]
  }
 ]
}
