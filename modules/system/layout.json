{
 "settings": [
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "form",
     "get": "/screen",
     "post": "/screen",
     "fields": [
      {
       "title": "Max columns: dashboard",
       "sub_text": "dash_cols",
       "controls": [
        {
         "type": "choice",
         "key": "dash_cols",
         "options": "cols",
         "label": "Columns"
        }
       ]
      },
      {
       "title": "Max columns: settings",
       "sub_text": "set_cols",
       "controls": [
        {
         "type": "choice",
         "key": "set_cols",
         "options": "cols",
         "label": "Columns"
        }
       ]
      }
     ]
    },
    {
     "type": "row",
     "title": "Stretch boxes",
     "sub": "On a wide screen the columns fill the width, so the boxes are wider",
     "control": {
      "type": "toggle",
      "bind": "@screen.stretch",
      "post": "/screen/stretch",
      "label": "Stretch boxes"
     }
    },
    {
     "type": "row",
     "title": "Scale content",
     "sub": "The content of a stretched box grows with it, so the box is taller too (off: the content keeps its size)",
     "show": "@screen.stretch",
     "control": {
      "type": "toggle",
      "bind": "@screen.scale",
      "post": "/screen/scale",
      "label": "Scale content"
     }
    },
    {
     "type": "row",
     "title": "Rearrange the main screen",
     "sub": "A handle on each tile lets you drag it to another place; the modules take that order (the same as dragging them in Modules)",
     "control": {
      "type": "toggle",
      "bind": "@screen.drag",
      "post": "/screen/drag",
      "label": "Rearrange the main screen"
     }
    },
    {
     "type": "row",
     "title": "No scrolling",
     "sub": "The main screen never scrolls: it stays as it is drawn, so people can only tap what is on the screen (use with columns, and a screen that is big enough)",
     "control": {
      "type": "toggle",
      "bind": "@screen.noscroll",
      "post": "/screen/noscroll",
      "label": "No scrolling"
     }
    },
    {
     "type": "row",
     "title": "Ask for the PIN to open Settings",
     "sub": "The dashboard keeps working without it; opening Settings and changing anything in it needs the PIN. Set a PIN below first.",
     "control": {
      "type": "toggle",
      "bind": "@settings_pin.on",
      "post": "/settings-pin",
      "label": "Ask for the PIN to open Settings",
      "ensure_pin": true
     }
    },
    {
     "type": "row",
     "title": "PIN",
     "sub": "4 to 64 characters. It is also asked for before updating, and restarting the Pi.",
     "control": {
      "type": "pinset"
     }
    }
   ]
  },
  {
   "box": "colours",
   "title": "Global colours",
   "items": [
    {
     "type": "row",
     "title": "Global main colour",
     "sub": "Pick Global main for a box or a button to give it this colour",
     "control": {
      "type": "colourpick",
      "id": "global",
      "label": "Global main colour"
     }
    },
    {
     "type": "form",
     "get": "/highlight",
     "post": "/highlight",
     "fields": [
      {
       "title": "Notification highlight",
       "sub_text": "highlight",
       "controls": [
        {
         "type": "select",
         "key": "style",
         "options": "styles",
         "label": "Look"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "box": "about",
   "title": "About",
   "items": [
    {
     "type": "info",
     "source": "/about"
    },
    {
     "type": "form",
     "get": "/timezone",
     "post": "/timezone",
     "fields": [
      {
       "title": "Time zone",
       "sub_text": "zone",
       "controls": [
        {
         "type": "select",
         "key": "zone",
         "options": "zones",
         "label": "Time zone"
        }
       ]
      }
     ]
    },
    {
     "type": "row",
     "title": "GitHub",
     "sub": "Source, instructions and updates",
     "control": {
      "type": "link",
      "label": "Open",
      "href": "https://github.com/blaskkaffe/DreamPiAutoToggle",
      "aria": "Open the project on GitHub"
     }
    }
   ]
  }
 ]
}
