{
 "dashboard": [
  {
   "box": "debug log",
   "items": [
    {
     "type": "infobox",
     "label": "Debug log",
     "rows": [
      {
       "label": "Log",
       "main": true,
       "value": {
        "type": "text",
        "text": "@debuglog.last",
        "style": "log"
       },
       "only": "closed",
       "full": true,
       "tight": true
      },
      {
       "label": "",
       "value": {
        "type": "bar",
        "items": [
         {
          "type": "button",
          "label": "@debuglog.button",
          "post": "/debug"
         },
         {
          "type": "bar",
          "show": "@debug",
          "items": [
           {
            "type": "button",
            "label": "Clear",
            "post": "/clearlog"
           },
           {
            "type": "toggle",
            "label": "Follow",
            "local": "follow",
            "default": true,
            "look": "pri",
            "text": "Follow"
           }
          ]
         }
        ]
       },
       "full": true,
       "tight": true
      },
      {
       "label": "",
       "show": "@debug",
       "value": {
        "type": "bar",
        "items": [
         {
          "type": "link",
          "label": "Newest 256 KB",
          "href": "/dtmf"
         },
         {
          "type": "link",
          "label": "Full log",
          "href": "/dtmf?all"
         }
        ]
       },
       "full": true,
       "tight": true
      },
      {
       "label": "",
       "value": {
        "type": "console",
        "tail": "/log",
        "nowrap": true,
        "height": "40vh",
        "label": "Debug log",
        "active": "@debug",
        "follow": "@_local.follow",
        "rules": [
         [
          "modem: DTMF",
          "l-ok l-b"
         ],
         [
          "netswitch:|add-on:",
          "l-info"
         ],
         [
          "web page:",
          "l-warn"
         ],
         [
          "underrun",
          "l-dim"
         ],
         [
          "fail|error|Couldn't|Unable|No carrier|NO CARRIER",
          "l-err"
         ],
         [
          "modem",
          "l-mod"
         ]
        ]
       },
       "full": true,
       "bleed": true
      }
     ]
    }
   ]
  }
 ],
 "settings": [
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "row",
     "title": "Debug log colour",
     "sub": "Module",
     "control": {
      "type": "swatches",
      "key": "debuglog",
      "tint": true,
      "title": "Colour of the debug log"
     }
    }
   ]
  }
 ]
}
