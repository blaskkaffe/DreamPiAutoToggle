{
 "settings": [
  {
   "box": "system",
   "title": "System",
   "items": [
    {
     "type": "row",
     "title": "Updates",
     "sub": "@update.text",
     "control": {
      "type": "button",
      "label": "Check",
      "post": "/update/check",
      "reload": "update",
      "disabled": "@update.check_disabled"
     }
    },
    {
     "type": "row",
     "title": "Update the add-on",
     "sub": "@update.do_sub",
     "show": "@update.show_update",
     "control": {
      "type": "button",
      "label": "Update now",
      "post": "/update/start",
      "reload": "update",
      "pin": true,
      "confirm": "Update the add-on now? It is fetched from GitHub and installed; this page is unavailable for a few seconds."
     }
    },
    {
     "type": "row",
     "title": "Update from a USB stick",
     "sub": "@update.usb_text",
     "show": "@update.show_usb",
     "control": {
      "type": "button",
      "label": "Install from USB",
      "post": "/update/usb",
      "reload": "update",
      "pin": true,
      "confirm": "Install the update from the USB stick now? The page is unavailable for a few seconds."
     }
    },
    {
     "type": "console",
     "lines": "@update.log",
     "hide_empty": true,
     "label": "Update log",
     "rules": [
      [
       "\\b(fail|failed|error|fatal|denied|cannot|could not|not found)\\b",
       "l-err"
      ],
      [
       "^(ok|done|updated|installed|.*\\b(already up to date|fast-forward)\\b)",
       "l-ok"
      ],
      [
       "^(updating|running)\\b",
       "l-hd"
      ],
      [
       "^(from|remote:|\\s*\\d+ file|\\s*create mode|\\s*delete mode)",
       "l-dim"
      ]
     ]
    },
    {
     "type": "row",
     "title": "Reboot",
     "sub": "Restarts the computer",
     "control": {
      "type": "button",
      "style": "danger",
      "label": "Reboot",
      "post": "/reboot",
      "pin": true,
      "confirm": "@reboot.confirm",
      "then": "wait"
     }
    }
   ]
  }
 ],
 "data": {
  "update": {
   "url": "/update",
   "every": 30,
   "retry": 2,
   "retry_if": "busy",
   "when": "settings"
  }
 }
}
