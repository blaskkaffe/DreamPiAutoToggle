# /etc/default/dcbridge -- network settings for the dcbridge Dreamcast links.
# After editing:  sudo @MODULE@/system/dcbridge-net reload

# Virtual W5500 (KOS w5500_adapter): a small routed subnet on dcnet0.
# The Pi is the gateway and DNS server; dnsmasq hands the Dreamcast an address.
DCNET_IF=dcnet0
DCNET_ADDR=192.168.170.1
DCNET_PREFIX=24
DCNET_DHCP_FIRST=192.168.170.2
DCNET_DHCP_LAST=192.168.170.20

# PPP over the Dreamcast serial port (KOS libppp, ppp_scif_init()).
# unit 10 => interface ppp10, so DreamPi's modem link keeps ppp0.
PPP_UNIT=10
# Serial speed. With the bridge in "cable" mode the Dreamcast-side UART follows
# this number exactly as KOS computes it ("115200" really runs at 120192), so
# set it to what the Dreamcast program passes to ppp_scif_init().
PPP_BAUD=115200
PPP_LOCAL=192.168.171.1
PPP_REMOTE=192.168.171.2

# DNS handed to the Dreamcast. Empty = the Pi itself (DreamPi's dnsmasq, with
# its dreamcast.online server redirects). Set e.g. 46.101.91.123 to bypass it.
DNS_SERVER=

# Raise the TTL of forwarded Dreamcast packets to 64, as dreampi.py does for
# its modem link (some game stacks send TTL 30).
SET_TTL=yes

# Optional inbound port forwards to the Dreamcast, space separated
# "proto:port[-port]:target", target = dcnet or ppp. Example:
#   FORWARD_PORTS="udp:7648-7649:ppp tcp:2048:dcnet"
# The PPP Dreamcast is always PPP_REMOTE; the W5500 one is DCNET_DHCP_FIRST
# (it is the only DHCP client on that link). Your router must forward the same
# ports to this Pi.
FORWARD_PORTS=
