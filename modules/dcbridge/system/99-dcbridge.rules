# /etc/udev/rules.d/99-dcbridge.rules
# Stable names for the dcbridge RP2040 so it can never be mistaken for the
# DreamPi USB modem (both are /dev/ttyACM*, and enumeration order varies).
#
#   /dev/dcbridge-uart  Dreamcast SCIF serial (PPP, KOS console)
#   /dev/dcbridge-ctl   status JSON lines + commands (status / reboot / bootsel)
#   /dev/dcbridge-disk  virtual SD card sectors (dcbridge-saves daemon)
#   dcnet0              Ethernet wire of the virtual W5500
#
# Install:  sudo cp 99-dcbridge.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger

ACTION!="add|change", GOTO="dcbridge_end"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ATTRS{manufacturer}=="dcbridge", \
    ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ATTRS{manufacturer}=="dcbridge", \
    ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="dcbridge-uart", MODE="0660", GROUP="dialout", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="dcbridge-ppp.service"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ATTRS{manufacturer}=="dcbridge", \
    ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="dcbridge-ctl", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ATTRS{manufacturer}=="dcbridge", \
    ENV{ID_USB_INTERFACE_NUM}=="06", SYMLINK+="dcbridge-disk", MODE="0660", GROUP="dialout"

SUBSYSTEM=="net", ACTION=="add", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", \
    ATTRS{manufacturer}=="dcbridge", NAME="dcnet0", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="dcbridge-dcnet.service"

LABEL="dcbridge_end"
