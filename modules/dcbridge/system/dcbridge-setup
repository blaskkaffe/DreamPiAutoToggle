#!/bin/sh
# DC Bridge: sets the Pi's side of the bridge up or takes it out again. Run as root, by the module's Settings buttons (the dashboard
# starts it in a transient systemd unit, because the web service itself may not write to /etc or /usr) and by the add-on's install.sh
# (--dcbridge / --no-dcbridge / an update while it is installed).
#
#   dcbridge-setup install [STATUSFILE LOGFILE]   packages, udev rules, units, pppd options, DHCP / DNS file, firewall chains, sysctl, saves service
#   dcbridge-setup remove  [STATUSFILE LOGFILE]   the same taken out again; the saves (/var/lib/dcbridge) and /etc/default/dcbridge are kept
#
# With STATUSFILE and LOGFILE it writes running / ok / failed to the first and all its output to the second (the dashboard shows both).
# It never touches DreamPi's own files. See docs/dcbridge.md.
ACTION="$1"
STATUS="$2"
LOG="$3"
DCB_MOD=$(cd "$(dirname "$0")/.." && pwd)

if [ -n "$LOG" ]; then
    : > "$LOG"
    exec >>"$LOG" 2>&1
fi
say_state() { [ -n "$STATUS" ] && echo "$1" > "$STATUS"; return 0; }
fail() {
    echo "Failed: $1"
    say_state failed
    exit 1
}

do_install() {
    if command -v apt-get >/dev/null 2>&1; then
        echo "Installing packages (mtools dosfstools python3 ppp dnsmasq iptables)..."
        PKGS="mtools dosfstools python3 ppp dnsmasq iptables"
        DEBIAN_FRONTEND=noninteractive apt-get install -y -q $PKGS \
            || { echo "Updating the package lists and trying again..."; apt-get update -q; DEBIAN_FRONTEND=noninteractive apt-get install -y -q $PKGS; } \
            || fail "could not install $PKGS (is the Pi online?)"
    else
        echo "No apt-get here: install mtools, dosfstools, python3, ppp, dnsmasq and iptables yourself."
    fi
    echo "Setting the bridge up..."
    mkdir -p /var/lib/dcbridge || fail "could not create /var/lib/dcbridge"
    chmod +x "$DCB_MOD/system/dcbridge-net"
    install -m 644 "$DCB_MOD/system/dcbridge.ppp-options" /etc/ppp/dcbridge.options || fail "could not write /etc/ppp/dcbridge.options"
    [ -e /etc/default/dcbridge ] || sed "s#@MODULE@#$DCB_MOD#g" "$DCB_MOD/system/dcbridge.default" > /etc/default/dcbridge
    # keep other network managers away from the two links
    if [ -f /etc/dhcpcd.conf ] && ! grep -q "dcbridge" /etc/dhcpcd.conf; then
        printf '\n# dcbridge: these links are configured by dcbridge-net\ndenyinterfaces dcnet0 ppp10\n' >> /etc/dhcpcd.conf
    fi
    if [ -d /etc/NetworkManager/conf.d ]; then
        printf '[keyfile]\nunmanaged-devices=interface-name:dcnet0;interface-name:ppp10\n' > /etc/NetworkManager/conf.d/dcbridge.conf
    fi
    echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/90-dcbridge.conf
    sysctl -q -p /etc/sysctl.d/90-dcbridge.conf || true
    cp "$DCB_MOD/system/99-dcbridge.rules" /etc/udev/rules.d/ || fail "could not write the udev rules"
    for unit in dcbridge-saves dcbridge-dcnet dcbridge-ppp; do
        sed "s#@MODULE@#$DCB_MOD#g" "$DCB_MOD/system/$unit.service" > "/etc/systemd/system/$unit.service" || fail "could not write $unit.service"
    done
    systemctl daemon-reload
    systemctl enable dnsmasq >/dev/null 2>&1 || true
    "$DCB_MOD/system/dcbridge-net" dnsmasq-conf || true
    "$DCB_MOD/system/dcbridge-net" firewall-up || true
    udevadm control --reload || true
    udevadm trigger --subsystem-match=tty --subsystem-match=net || true
    systemctl enable dcbridge-saves.service >/dev/null 2>&1 || true
    systemctl restart dcbridge-saves.service || fail "the saves service did not start (sudo systemctl status dcbridge-saves)"
    echo "Done. Network settings are in /etc/default/dcbridge (then: sudo $DCB_MOD/system/dcbridge-net reload)."
}

do_remove() {
    echo "Stopping the bridge services..."
    systemctl disable --now dcbridge-saves.service >/dev/null 2>&1 || true
    systemctl stop dcbridge-ppp.service dcbridge-dcnet.service >/dev/null 2>&1 || true
    [ -x "$DCB_MOD/system/dcbridge-net" ] && "$DCB_MOD/system/dcbridge-net" firewall-down >/dev/null 2>&1
    echo "Taking its files out of the system..."
    rm -f /etc/systemd/system/dcbridge-saves.service /etc/systemd/system/dcbridge-dcnet.service /etc/systemd/system/dcbridge-ppp.service
    rm -f /etc/udev/rules.d/99-dcbridge.rules /etc/ppp/dcbridge.options /etc/NetworkManager/conf.d/dcbridge.conf /etc/sysctl.d/90-dcbridge.conf
    if [ -f /etc/dnsmasq.d/dcbridge.conf ]; then
        rm -f /etc/dnsmasq.d/dcbridge.conf
        systemctl restart dnsmasq >/dev/null 2>&1 || true
    fi
    if [ -f /etc/dhcpcd.conf ] && grep -q "dcbridge" /etc/dhcpcd.conf; then
        sed -i '/^# dcbridge: these links are configured by dcbridge-net$/d; /^denyinterfaces dcnet0 ppp10$/d' /etc/dhcpcd.conf
    fi
    systemctl daemon-reload >/dev/null 2>&1 || true
    udevadm control --reload >/dev/null 2>&1 || true
    echo "Done. The saves in /var/lib/dcbridge and the settings in /etc/default/dcbridge are kept."
}

case "$ACTION" in
    install) say_state running; do_install; say_state ok ;;
    remove)  say_state running; do_remove; say_state ok ;;
    *) echo "usage: dcbridge-setup install|remove [STATUSFILE LOGFILE]" >&2; exit 2 ;;
esac
