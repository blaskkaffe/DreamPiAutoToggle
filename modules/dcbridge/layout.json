{
 "dashboard": [
  {
   "box": "dc bridge",
   "items": [
    {
     "type": "infobox",
     "label": "Dreamcast bridge:",
     "rows": [
      {
       "label": "Dreamcast",
       "main": true,
       "value": {
        "type": "status",
        "dot": "@dcbridge.dreamcast.state",
        "text": "@dcbridge.dreamcast.text"
       }
      },
      {
       "label": "SD card",
       "value": {
        "type": "status",
        "dot": "@dcbridge.card.state",
        "text": "@dcbridge.card.text",
        "sub": "@dcbridge.card.sub"
       }
      },
      {
       "label": "Network",
       "value": {
        "type": "status",
        "dot": "@dcbridge.net.state",
        "text": "@dcbridge.net.text"
       }
      },
      {
       "label": "Mode",
       "value": {
        "type": "status",
        "dot": "@dcbridge.mode.state",
        "text": "@dcbridge.mode.text"
       }
      },
      {
       "label": "",
       "value": {
        "type": "bar",
        "items": [
         {
          "type": "link",
          "label": "Save manager",
          "href": "/dcbridge/"
         }
        ]
       },
       "full": true,
       "tight": true,
       "show": "@dcbridge.installed"
      }
     ]
    }
   ]
  }
 ],
 "settings": [
  {
   "box": "appearance",
   "title": "Appearance",
   "items": [
    {
     "type": "row",
     "title": "DC Bridge colour",
     "sub": "Module",
     "control": {
      "type": "swatches",
      "key": "dcbridge",
      "tint": true,
      "title": "Colour of the DC Bridge box"
     }
    }
   ]
  },
  {
   "box": "dc bridge",
   "title": "DC Bridge",
   "items": [
    {
     "type": "row",
     "title": "Bridge software",
     "sub": "@dcbridge.setup.text",
     "show": "@dcbridge.setup.not_installed",
     "control": {
      "type": "button",
      "label": "Install",
      "post": "/dcbridge-setup/install",
      "pin": true,
      "disabled": "@dcbridge.setup.running",
      "confirm": "Install the DC Bridge on this Pi? It downloads packages (mtools, dosfstools, ppp, dnsmasq, iptables) and adds the bridge's services, udev rules and firewall chains. DreamPi's own files are not touched."
     }
    },
    {
     "type": "row",
     "title": "Bridge software",
     "sub": "@dcbridge.setup.text",
     "show": "@dcbridge.installed",
     "control": {
      "type": "button",
      "label": "Uninstall",
      "style": "danger",
      "post": "/dcbridge-setup/remove",
      "pin": true,
      "disabled": "@dcbridge.setup.running",
      "confirm": "Uninstall the DC Bridge from this Pi? Its services, udev rules, firewall chains and DHCP / DNS file are removed. The saves in /var/lib/dcbridge and the settings in /etc/default/dcbridge are kept."
     }
    },
    {
     "type": "form",
     "get": "/dcbridge-mode",
     "post": "/dcbridge-mode",
     "show": "@dcbridge.installed",
     "fields": [
      {
       "title": "Bridge mode",
       "sub_text": "mode",
       "controls": [
        {
         "type": "choice",
         "key": "mode",
         "options": "modes",
         "label": "Mode"
        }
       ]
      }
     ]
    },
    {
     "type": "row",
     "title": "Save manager",
     "sub": "Download, upload, label and restore the Dreamcast's saves on the virtual SD card (openMenu's serial VMU)",
     "control": {
      "type": "link",
      "label": "Open",
      "href": "/dcbridge/",
      "aria": "Open the save manager"
     },
     "show": "@dcbridge.installed"
    },
    {
     "type": "row",
     "title": "All saves",
     "sub": "A zip of every save on the virtual card, with titles and labels",
     "control": {
      "type": "link",
      "label": "Download",
      "href": "/dcbridge/api/export.zip",
      "aria": "Download all saves as a zip"
     },
     "show": "@dcbridge.installed"
    },
    {
     "type": "row",
     "title": "SD card trace",
     "sub": "What the virtual SD card last saw from the Dreamcast: commands, answers, raw bytes (for diagnosing openMenu)",
     "show": "@dcbridge.installed",
     "control": {
      "type": "link",
      "label": "Open",
      "href": "/dcbridge/api/bridge/trace",
      "aria": "Open the SD card trace"
     }
    },
    {
     "type": "console",
     "lines": "@dcbridge.setup.log",
     "hide_empty": true,
     "label": "Setup log",
     "rules": [
      [
       "\\b(fail|failed|error|fatal|denied|cannot|could not|not found)\\b",
       "l-err"
      ],
      [
       "^(done)",
       "l-ok"
      ]
     ]
    }
   ]
  }
 ]
}
